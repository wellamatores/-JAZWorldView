                retry: 'Retrying...',
                apiError: 'Failed to load stations. Please refresh.',
                mapCaption: 'Port Galib · Red Sea, Egypt',
                footerDev: 'Developed in',
                footerCity: 'Halmstad, Sweden',
                footerCommissioned: 'Commissioned by',
                footerTravco: 'Travco Travel Company',
                footerApi: 'Radio Browser API',
                genres: {
                    all: '🎵 All',
                    pop: '🎤 Pop',
                    rock: '🎸 Rock',
                    jazz: '🎷 Jazz',
                    electronic: '🎧 Electronic',
                    classical: '🎻 Classical',
                    news: '📰 News',
                    talk: '💬 Talk',
                    beach: '🏖️ Beach'
                },
                status: {
                    off: 'Off',
                    live: 'Live',
                    loading: 'Loading...'
                }
            },
            ar: {
                code: 'ar',
                flag: '🇪🇬',
                label: 'عربي',
                dir: 'rtl',
                brand: 'بورت غالب إف إم/إيه إم',
                subtitle: 'البحر الأحمر · 94.5 FM',
                freqLabel: 'التردد',
                tuneLabel: 'ضبط',
                power: 'تشغيل',
                stationTitle: 'اختر محطة',
                stationMeta: '— راديو الشاطئ',
                badgeOff: '● إيقاف',
                badgeLive: '● بث مباشر',
                loading: 'جاري تحميل المحطات...',
                count: 'محطة · Radio Browser API',
                error: '⚠️ البث غير متاح – إعادة المحاولة...',
                noStations: 'لم يتم العثور على محطات',
                retry: 'جاري إعادة المحاولة...',
                apiError: 'فشل تحميل المحطات. يرجى التحديث.',
                mapCaption: 'بورت غالب · البحر الأحمر، مصر',
                footerDev: 'تم التطوير في',
                footerCity: 'هالمستاد، السويد',
                footerCommissioned: 'بتكليف من',
                footerTravco: 'شركة ترافكو للسياحة',
                footerApi: 'Radio Browser API',
                genres: {
                    all: '🎵 الكل',
                    pop: '🎤 بوب',
                    rock: '🎸 روك',
                    jazz: '🎷 جاز',
                    electronic: '🎧 إلكتروني',
                    classical: '🎻 كلاسيكي',
                    news: '📰 أخبار',
                    talk: '💬 حوار',
                    beach: '🏖️ شاطئ'
                },
                status: {
                    off: 'إيقاف',
                    live: 'بث مباشر',
                    loading: 'جاري التحميل...'
                }
            }
        };

        let currentLang = 'en';

        // ================================================================
        //  THEME
        // ================================================================
        let currentTheme = 'light';

        function setTheme(theme) {
            currentTheme = theme;
            document.documentElement.setAttribute('data-theme', theme === 'dark' ? 'dark' : 'light');
            const icon = document.getElementById('themeIcon');
            const label = document.getElementById('themeLabel');
            if (theme === 'dark') {
                icon.className = 'fas fa-moon';
                label.textContent = 'Dark';
            } else {
                icon.className = 'fas fa-sun';
                label.textContent = 'Light';
            }
            try { localStorage.setItem('portgalib-theme', theme); } catch(_) {}
        }

        function toggleTheme() {
            setTheme(currentTheme === 'light' ? 'dark' : 'light');
        }

        try {
            const saved = localStorage.getItem('portgalib-theme');
            if (saved === 'dark' || saved === 'light') setTheme(saved);
            else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) setTheme('dark');
        } catch(_) {}

        document.getElementById('themeToggle').addEventListener('click', toggleTheme);

        // ================================================================
        //  LANGUAGE
        // ================================================================
        function setLanguage(lang) {
            currentLang = lang;
            const t = LANG[lang];
            document.documentElement.dir = t.dir;
            document.documentElement.lang = lang;

            document.getElementById('langFlag').textContent = t.flag;
            document.getElementById('langLabel').textContent = t.label;

            // Update all translatable elements
            document.querySelector('.logo-text h1').textContent = t.brand;
            document.getElementById('subtitle').innerHTML = `
                <i class="fas fa-umbrella-beach"></i> ${t.subtitle}
                <i class="fas fa-sun"></i>
                <a href="https://travco.com/en/" target="_blank" class="travco-badge">
                    <i class="fas fa-building"></i> Travco
                </a>
            `;

            document.getElementById('freqLabel').textContent = t.freqLabel;
            document.getElementById('tuneLabel').textContent = t.tuneLabel;
            document.getElementById('powerBtn').innerHTML = `⏻ ${t.power}`;

            document.getElementById('stationTitle').textContent = t.stationTitle;
            document.getElementById('stationMeta').textContent = t.stationMeta;
            document.getElementById('badge').textContent = t.badgeOff;

            document.getElementById('loadingText').textContent = t.loading;
            document.getElementById('mapCaption').innerHTML = `<i class="fas fa-map-pin"></i> ${t.mapCaption}`;

            document.getElementById('footerDev').textContent = t.footerDev;
            document.getElementById('footerCity').textContent = t.footerCity;
            document.getElementById('footerCommissioned').textContent = t.footerCommissioned;
            document.getElementById('footerTravco').textContent = t.footerTravco;
            document.getElementById('footerApi').textContent = t.footerApi;

            // Genres
            document.getElementById('gAll').textContent = t.genres.all;
            document.getElementById('gPop').textContent = t.genres.pop;
            document.getElementById('gRock').textContent = t.genres.rock;
            document.getElementById('gJazz').textContent = t.genres.jazz;
            document.getElementById('gElectronic').textContent = t.genres.electronic;
            document.getElementById('gClassical').textContent = t.genres.classical;
            document.getElementById('gNews').textContent = t.genres.news;
            document.getElementById('gTalk').textContent = t.genres.talk;
            document.getElementById('gBeach').textContent = t.genres.beach;

            // Status
            updateStatusUI();

            try { localStorage.setItem('portgalib-lang', lang); } catch(_) {}
        }

        function toggleLanguage() {
            setLanguage(currentLang === 'en' ? 'ar' : 'en');
        }

        try {
            const savedLang = localStorage.getItem('portgalib-lang');
            if (savedLang === 'ar' || savedLang === 'en') setLanguage(savedLang);
        } catch(_) {}

        document.getElementById('langToggle').addEventListener('click', toggleLanguage);

        // ================================================================
        //  RADIO BROWSER API
        // ================================================================
        const API_BASE_URLS = [
            'https://de1.api.radio-browser.info',
            'https://nl1.api.radio-browser.info',
            'https://uk1.api.radio-browser.info',
            'https://fr1.api.radio-browser.info',
            'https://it1.api.radio-browser.info'
        ];

        let currentApiIndex = 0;

        function getApiUrl() {
            return API_BASE_URLS[currentApiIndex % API_BASE_URLS.length];
        }

        function rotateApi() {
            currentApiIndex = (currentApiIndex + 1) % API_BASE_URLS.length;
        }

        // --- DOM refs ---
        const freqDisplay = document.getElementById('freqDisplay');
        const freqSlider = document.getElementById('freqSlider');
        const signalFill = document.getElementById('signalFill');
        const ledIndicator = document.getElementById('ledIndicator');
        const statusText = document.getElementById('statusText');
        const powerBtn = document.getElementById('powerBtn');
        const stationNameEl = document.getElementById('stationName');
        const volumeSlider = document.getElementById('volumeSlider');
        const badge = document.getElementById('badge');
        const stationGrid = document.getElementById('stationGrid');
        const genreFilter = document.getElementById('genreFilter');
        const errorMsg = document.getElementById('errorMsg');
        const stationCount = document.getElementById('stationCount');

        // --- Audio ---
        let audio = null;
        let currentStreamUrl = '';
        let currentStation = null;
        let isPlaying = false;
        let retryCount = 0;
        let retryTimeout = null;

        // --- State ---
        const state = {
            frequency: 87.5,
            isOn: false,
            volume: 70,
            isBuffering: false,
            currentGenre: 'all',
            stations: [],
            isLoading: false
        };

        // --- Init audio ---
        function initAudio() {
            if (audio) {
                audio.pause();
                audio.src = '';
                audio = null;
            }
            audio = new Audio();
            audio.crossOrigin = 'anonymous';
            audio.preload = 'auto';

            audio.addEventListener('playing', () => {
                state.isBuffering = false;
                errorMsg.classList.remove('show');
                retryCount = 0;
                updateUI();
            });

            audio.addEventListener('waiting', () => {
                state.isBuffering = true;
                updateUI();
            });

            audio.addEventListener('error', (e) => {
                console.error('Stream error:', e);
                state.isBuffering = false;
                const t = LANG[currentLang];
                errorMsg.textContent = t.error;
                errorMsg.classList.add('show');
                updateUI();

                if (state.isOn && currentStreamUrl && retryCount < 3) {
                    retryCount++;
                    if (retryTimeout) clearTimeout(retryTimeout);
                    retryTimeout = setTimeout(() => {
                        console.log(`Retry ${retryCount}...`);
                        playStream(currentStreamUrl);
                    }, 3000 * retryCount);
                } else if (retryCount >= 3) {
                    errorMsg.textContent = '⚠️ Unable to connect – try another station';
                }
            });

            audio.addEventListener('ended', () => {
                if (state.isOn && currentStreamUrl) {
                    setTimeout(() => playStream(currentStreamUrl), 1000);
                }
            });

            return audio;
        }

        function playStream(url) {
            if (!url) return;
            try {
                if (!audio) initAudio();
                currentStreamUrl = url;
                audio.src = url;
                audio.volume = state.volume / 100;
                const promise = audio.play();
                if (promise !== undefined) {
                    promise.catch(err => {
                        console.warn('Play blocked:', err);
                        errorMsg.classList.add('show');
                    });
                }
                state.isOn = true;
                isPlaying = true;
                errorMsg.classList.remove('show');
                updateUI();
            } catch (e) {
                console.error('Play error:', e);
                errorMsg.classList.add('show');
            }
        }

        function stopAudio() {
            if (retryTimeout) {
                clearTimeout(retryTimeout);
                retryTimeout = null;
            }
            if (audio) {
                audio.pause();
                audio.src = '';
                currentStreamUrl = '';
            }
            isPlaying = false;
            state.isOn = false;
            state.isBuffering = false;
            errorMsg.classList.remove('show');
            retryCount = 0;
            updateUI();
        }

        function setVolume(value) {
            state.volume = Math.min(100, Math.max(0, value));
            if (audio) audio.volume = state.volume / 100;
        }

        // --- API: fetch stations ---
        async function fetchStations(genre = 'all') {
            if (state.isLoading) return;

            state.isLoading = true;
            const t = LANG[currentLang];
            stationGrid.innerHTML = `<div class="loading-spinner"><i class="fas fa-spinner"></i> ${t.loading}</div>`;
            stationCount.textContent = t.loading;

            let apiUrl = getApiUrl();

            try {
                let endpoint;
                if (genre === 'all') {
                    endpoint = `${apiUrl}/json/stations/topvote/100`;
                } else if (genre === 'beach') {
                    const encoded = encodeURIComponent('beach');
                    endpoint = `${apiUrl}/json/stations/bytag/${encoded}?limit=50`;
                } else {
                    const encodedTag = encodeURIComponent(genre);
                    endpoint = `${apiUrl}/json/stations/bytag/${encodedTag}?limit=50`;
                }

                const response = await fetch(endpoint);
                if (!response.ok) throw new Error(`HTTP ${response.status}`);

                const data = await response.json();

                if (!data || data.length === 0) {
                    stationGrid.innerHTML = `<div class="loading-spinner" style="color: #ff8866;">${t.noStations}</div>`;
                    stationCount.textContent = '0 ' + t.count.split('·')[0] + ' ' + t.count.split('·')[1] || '';
                    state.stations = [];
                    state.isLoading = false;
                    return;
                }

                let filtered = data.filter(s =>
                    s.urlResolved && s.urlResolved.startsWith('http') && s.lastCheckOk !== false
                );
                if (filtered.length === 0) {
                    filtered = data.filter(s => s.url && s.url.startsWith('http'));
                }

                state.stations = filtered.map((s, index) => ({
                    id: s.stationuuid || s.id || index,
                    name: s.name || 'Unknown Station',
                    genre: s.tags ? s.tags.split(',').slice(0, 3).join(', ') : genre,
                    url: s.urlResolved || s.url || '',
                    country: s.country || 'Unknown',
                    favicon: s.favicon || '',
                    votes: s.votes || 0,
                    bitrate: s.bitrate || 0,
                    codec: s.codec || '',
                    lastCheckOk: s.lastCheckOk !== false
                }));

                const seen = new Set();
                state.stations = state.stations.filter(s => {
                    const key = s.name.toLowerCase().trim();
                    if (seen.has(key)) return false;
                    seen.add(key);
                    return true;
                });

                state.stations.sort((a, b) => (b.votes || 0) - (a.votes || 0));
                if (state.stations.length > 50) state.stations = state.stations.slice(0, 50);

                renderStations();
                stationCount.textContent = `${state.stations.length} ${t.count}`;

                if (state.stations.length > 0 && !state.isOn) {
                    const first = state.stations[0];
                    currentStation = first;
                    updateStationUI(first);
                    const freq = 87.5 + (state.stations.indexOf(first) % 40) * 0.5;
                    const freqKey = Math.min(108, Math.max(87.5, freq)).toFixed(1);
                    freqDisplay.textContent = freqKey;
                    state.frequency = parseFloat(freqKey);
                }

            } catch (error) {
                console.error('API error:', error);
                rotateApi();
                const t2 = LANG[currentLang];
                if (currentApiIndex < API_BASE_URLS.length * 2) {
                    stationGrid.innerHTML = `<div class="loading-spinner"><i class="fas fa-spinner"></i> ${t2.retry}</div>`;
                    setTimeout(() => fetchStations(genre), 1000);
                } else {
                    stationGrid.innerHTML = `<div class="loading-spinner" style="color: #ff8866;">⚠️ ${t2.apiError}</div>`;
                    stationCount.textContent = 'API error – try again';
                }
            } finally {
                state.isLoading = false;
            }
        }

        // --- Render station grid ---
        function renderStations() {
            stationGrid.innerHTML = '';
            if (state.stations.length === 0) {
                const t = LANG[currentLang];
                stationGrid.innerHTML = `<div class="loading-spinner" style="color: #ff8866;">${t.noStations}</div>`;
                return;
            }

            state.stations.forEach((station, index) => {
                const btn = document.createElement('button');
                btn.className = 'station-preset';
                const fakeFreq = 87.5 + (index % 40) * 0.5;
                const freqKey = Math.min(108, Math.max(87.5, fakeFreq)).toFixed(1);
                btn.dataset.freq = freqKey;
                btn.dataset.index = index;

                const genreDisplay = station.genre.length > 20 ? station.genre.substring(0, 18) + '…' : station.genre;
                const countryDisplay = station.country.length > 12 ? station.country.substring(0, 10) + '…' : station.country;
                btn.innerHTML = `
                    ${station.name.substring(0, 16)}
                    <span class="genre-tag">${genreDisplay}</span>
                    <span class="country-tag">${countryDisplay}</span>
                `;
                btn.title = `${station.name} · ${station.genre} · ${station.country} · ${station.bitrate}kbps`;

                if (currentStation && station.id === currentStation.id) {
                    btn.classList.add('active');
                }

                btn.addEventListener('click', () => {
                    if (!state.isOn) state.isOn = true;
                    currentStation = station;
                    const streamUrl = station.url || station.urlResolved;
                    if (streamUrl) {
                        if (audio) audio.pause();
                        playStream(streamUrl);
                        updateStationUI(station);
                    } else {
                        const t = LANG[currentLang];
                        errorMsg.textContent = '⚠️ No stream URL available';
                        errorMsg.classList.add('show');
                    }
                    document.querySelectorAll('.station-preset').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    freqDisplay.textContent = freqKey;
                    state.frequency = parseFloat(freqKey);
                    freqSlider.value = freqKey;
                    updateUI();
                });

                stationGrid.appendChild(btn);
            });
        }

        function findStationByFreq(freq) {
            const key = parseFloat(freq).toFixed(1);
            const index = Math.round((parseFloat(key) - 87.5) / 0.5);
            if (index >= 0 && index < state.stations.length) return state.stations[index];
            return null;
        }

        function tuneTo(freq) {
            const key = parseFloat(freq).toFixed(1);
            state.frequency = parseFloat(key);
            freqDisplay.textContent = key;
            freqSlider.value = key;

            const station = findStationByFreq(key);

            if (station && state.isOn) {
                currentStation = station;
                if (audio) audio.pause();
                playStream(station.url);
                updateStationUI(station);
                document.querySelectorAll('.station-preset').forEach((btn, idx) => {
                    const stationIdx = parseInt(btn.dataset.index);
                    if (stationIdx >= 0 && state.stations[stationIdx] && state.stations[stationIdx].id === station.id) {
                        btn.classList.add('active');
                    } else {
                        btn.classList.remove('active');
                    }
                });
            } else if (station) {
                currentStation = station;
                updateStationUI(station);
                document.querySelectorAll('.station-preset').forEach((btn, idx) => {
                    const stationIdx = parseInt(btn.dataset.index);
                    if (stationIdx >= 0 && state.stations[stationIdx] && state.stations[stationIdx].id === station.id) {
                        btn.classList.add('active');
                    } else {
                        btn.classList.remove('active');
                    }
                });
            } else {
                if (!state.isOn) {
                    const t = LANG[currentLang];
                    document.getElementById('stationTitle').textContent = `${key} MHz`;
                    document.getElementById('stationMeta').textContent = '— no station';
                    document.getElementById('badge').textContent = t.badgeOff;
                    document.getElementById('badge').className = 'audio-badge off';
                }
                document.querySelectorAll('.station-preset').forEach(b => b.classList.remove('active'));
            }
            updateUI();
        }

        function updateStationUI(station) {
            if (!station) return;
            const t = LANG[currentLang];
            const badgeClass = state.isOn && isPlaying ? '' : 'off';
            const badgeText = state.isOn && isPlaying ? t.badgeLive : t.badgeOff;
            const genreDisplay = station.genre.length > 25 ? station.genre.substring(0, 22) + '…' : station.genre;
            document.getElementById('stationTitle').textContent = station.name;
            document.getElementById('stationMeta').textContent = `· ${genreDisplay} · ${station.country}`;
            document.getElementById('badge').textContent = badgeText;
            document.getElementById('badge').className = `audio-badge ${badgeClass}`;
        }

        function updateStatusUI() {
            const t = LANG[currentLang];
            if (state.isOn && isPlaying) {
                statusText.textContent = t.status.live;
            } else if (state.isOn && state.isBuffering) {
                statusText.textContent = t.status.loading;
            } else {
                statusText.textContent = t.status.off;
            }
        }

        function updateUI() {
            let strength = 0;
            if (state.isOn && isPlaying) strength = 0.65 + Math.random() * 0.3;
            else if (state.isOn && state.isBuffering) strength = 0.25 + Math.random() * 0.2;
            else strength = 0.05;
            signalFill.style.width = Math.min(100, Math.round(strength * 100)) + '%';

            updateStatusUI();

            if (state.isOn && isPlaying) {
                ledIndicator.className = 'led on';
            } else if (state.isOn && state.isBuffering) {
                ledIndicator.className = 'led buffering';
            } else {
                ledIndicator.className = 'led';
            }

            powerBtn.classList.toggle('on', state.isOn);
            const t = LANG[currentLang];
            powerBtn.innerHTML = `⏻ ${t.power}`;

            if (currentStation) updateStationUI(currentStation);
            volumeSlider.value = state.volume;
        }

        // --- Event listeners ---
        genreFilter.addEventListener('click', (e) => {
            const btn = e.target.closest('.genre-btn');
            if (!btn) return;
            const genre = btn.dataset.genre;
            document.querySelectorAll('.genre-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            state.currentGenre = genre;
            if (state.isOn) stopAudio();
            fetchStations(genre);
        });

        freqSlider.addEventListener('input', function(e) {
            tuneTo(parseFloat(e.target.value));
        });

        document.getElementById('freqUp').addEventListener('click', () => {
            tuneTo(Math.min(108, state.frequency + 0.5));
        });
        document.getElementById('freqDown').addEventListener('click', () => {
            tuneTo(Math.max(87.5, state.frequency - 0.5));
        });

        powerBtn.addEventListener('click', function() {
            if (state.isOn) {
                stopAudio();
            } else {
                const station = findStationByFreq(state.frequency);
                if (station && station.url) {
                    state.isOn = true;
                    playStream(station.url);
                    currentStation = station;
                    updateStationUI(station);
                    document.querySelectorAll('.station-preset').forEach((btn, idx) => {
                        const stationIdx = parseInt(btn.dataset.index);
                        if (stationIdx >= 0 && state.stations[stationIdx] && state.stations[stationIdx].id === station.id) {
                            btn.classList.add('active');
                        } else {
                            btn.classList.remove('active');
                        }
                    });
                } else if (state.stations.length > 0) {
                    const first = state.stations[0];
                    state.isOn = true;
                    playStream(first.url);
                    currentStation = first;
                    updateStationUI(first);
                    document.querySelectorAll('.station-preset').forEach((btn, idx) => {
                        if (idx === 0) btn.classList.add('active');
                        else btn.classList.remove('active');
                    });
                } else {
                    const t = LANG[currentLang];
                    alert(t.noStations + '. Please select a genre.');
                }
            }
        });

        volumeSlider.addEventListener('input', function(e) {
            setVolume(parseInt(e.target.value));
        });

        stationNameEl.addEventListener('dblclick', function() {
            if (state.stations.length === 0) return;
            const random = state.stations[Math.floor(Math.random() * state.stations.length)];
            if (!state.isOn) { state.isOn = true; playStream(random.url); }
            currentStation = random;
            updateStationUI(random);
            document.querySelectorAll('.station-preset').forEach((btn, idx) => {
                const stationIdx = parseInt(btn.dataset.index);
                if (stationIdx >= 0 && state.stations[stationIdx] && state.stations[stationIdx].id === random.id) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });
            const index = state.stations.indexOf(random);
            const fakeFreq = 87.5 + (index % 40) * 0.5;
            const freqKey = Math.min(108, Math.max(87.5, fakeFreq)).toFixed(1);
            freqDisplay.textContent = freqKey;
            state.frequency = parseFloat(freqKey);
            freqSlider.value = freqKey;
            updateUI();
        });

        freqDisplay.addEventListener('click', function() {
            if (state.isOn && currentStreamUrl && audio) {
                audio.pause();
                setTimeout(() => playStream(currentStreamUrl), 300);
            }
        });

        document.addEventListener('keydown', function(e) {
            if (e.target.tagName === 'INPUT') return;
            if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
                e.preventDefault();
                tuneTo(Math.min(108, state.frequency + 0.3));
            } else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
                e.preventDefault();
                tuneTo(Math.max(87.5, state.frequency - 0.3));
            } else if (e.key === ' ' || e.key === 'Space') {
                e.preventDefault();
                powerBtn.click();
            } else if (e.key === 't' || e.key === 'T') {
                toggleTheme();
            } else if (e.key === 'l' || e.key === 'L') {
                toggleLanguage();
            }
        });

        // --- Init ---
        fetchStations('all');
        setVolume(70);

        console.log('📻 Port Galib FM/AM · Beach Radio');
        console.log('🌐 API endpoints:', API_BASE_URLS);
        console.log('🏖️ Travco Travel Company · Egypt');
        console.log('📍 Developed in Halmstad, Sweden');
        console.log('💡 Click a station to play · T to toggle theme · L to toggle language');
    })();
</script>
</body>
</html>
