<script>
    (function() {
        'use strict';

        // ================================================================
        //  TRANSLATIONS
        // ================================================================
        const LANG = {
            en: {
                code: 'en',
                flag: '🇬🇧',
                label: 'EN',
                dir: 'ltr',
                brand: 'Port Galib FM/AM',
                subtitle: 'Red Sea · 94.5 FM',
